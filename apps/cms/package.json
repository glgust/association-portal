{
  "name": "@ascnucc/cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm media:config:check && cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -H 127.0.0.1 -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/seed.ts",
    "seed:migration-fixture": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/seed-migration-fixture.ts",
    "seed:e2e": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/seed-e2e.ts",
    "media:config:check": "node --import tsx scripts/verify-media-startup-config.ts",
    "start": "pnpm media:config:check && cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "test": "vitest run --config vitest.config.mts",
    "test:activities": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-activities.ts",
    "test:announcements": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-announcement-publication.ts",
    "test:association-pages": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-association-pages.ts",
    "test:local-acceptance": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-local-acceptance.ts",
    "test:membership-account-claim": "vitest run --config vitest.config.mts account-claim && vitest run --config vitest.config.mts member-collection-access && cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-membership-account-claim.ts",
    "test:news": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-news.ts",
    "test:migrations": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-migration-paths.ts",
    "test:business-loop": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-business-loop.ts",
    "test:form-versioning": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-form-versioning.ts",
    "test:gallery-media": "vitest run --config vitest.config.mts tests/media-access.spec.ts tests/media-bounded-body.spec.ts tests/media-image-processing.spec.ts tests/media-object-storage.spec.ts tests/media-storage-config.spec.ts tests/media-storage-e2e-config.spec.ts tests/media-upload-compensation.spec.ts tests/media-upload-route.spec.ts tests/gallery-image-route.spec.ts tests/m012-media-gallery-migration.spec.ts src/modules/content/gallery/author-candidates.spec.ts src/modules/content/gallery/hooks.spec.ts src/modules/content/gallery/public-read.spec.ts src/modules/content/gallery/publication.spec.ts src/modules/content/gallery/slug.spec.ts ../web/src/app/gallery/gallery-list-consumers.spec.node --import tsx ../web/src/app/gallery/gallery-detail-consumers.spec.node --import tsx ../web/src/app/media/gallery/gallery-image-proxy.spec.ts",
    "test:gallery-media:r1": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-media-r1.ts",
    "test:gallery-media:r2": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-media-r1.ts",
    "test:gallery-transactions:r1": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-gallery-transactions.ts",
    "test:identity-access": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-identity-access.ts",
    "test:e2e": "playwright test",
    "verify:migration-fixture": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx scripts/verify-migration-fixture.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ascnucc/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1117.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "28.0.0",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "license": "Apache-2.0"
}
