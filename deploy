  fi
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_POSTGRES_IMAGE 'postgres:17.11-alpine3.23@sha256:9ae4e8f8d0284836a505f0b2e825144e32e20499856e7dc5f7b99e19d10eedd6'
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_MINIO_IMAGE 'minio/minio:RELEASE.2025-06-13T11-33-47Z@sha256:064117214caceaa8d8a90ef7caa58f2b2aeb316b5156afe9ee8da5b4d83e12c8'
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_MC_IMAGE 'minio/mc:RELEASE.2025-05-21T01-59-54Z@sha256:09f93f534cde415d192bb6084dd0e0ddd1715fb602f8a922ad121fd2bf0f8b44'
  config_write_line "$DEPLOY_CONFIG_TMP" DATABASE_URL "$DEPLOY_INIT_DATABASE_URL"
