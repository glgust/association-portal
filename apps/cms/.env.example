DATABASE_URL=postgres://ascnucc_demo:ascnucc_demo@localhost:5432/ascnucc_demo_dev
PAYLOAD_SECRET=replace-with-a-long-random-local-secret
MEDIA_STORAGE_MODE=local
MEDIA_LOCAL_ROOT=replace-with-an-absolute-local-media-path
# S3-compatible 模式改为 MEDIA_STORAGE_MODE=s3，并从安全配置提供以下全部变量：
# MEDIA_S3_ENDPOINT=https://replace-with-private-s3-endpoint
# MEDIA_S3_REGION=replace-with-region
# MEDIA_S3_BUCKET=replace-with-private-bucket
# MEDIA_S3_ACCESS_KEY_ID=replace-with-access-key-id
# MEDIA_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# MEDIA_S3_FORCE_PATH_STYLE=false
DEMO_ADMIN_USERNAME=demo-owner
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
DEMO_STAFF_USERNAME=demo-staff
DEMO_STAFF_PASSWORD=replace-with-a-local-demo-password
DEMO_CADRE_USERNAME=demo-cadre
DEMO_CADRE_PASSWORD=replace-with-a-local-demo-password
