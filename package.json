{
  "name": "association-portal",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test",
    "dev": "pnpm --parallel --filter @ascnucc/web --filter @ascnucc/cms dev",
    "dev:cms": "pnpm --filter @ascnucc/cms dev",
    "dev:web": "pnpm --filter @ascnucc/web dev",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "demo:init": "node scripts/demo-init.mjs"
  },
  "devDependencies": {
    "prettier": "3.4.2"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "dompurify@>=3 <3.4.13": "3.4.13",
      "postcss@>=8 <8.5.23": "8.5.23",
      "fast-uri@>=3 <3.1.6": "3.1.6",
      "undici@>=7 <7.29.0": "7.29.0",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "browserslist@>=4 <4.28.7": "4.28.7",
      "baseline-browser-mapping@>=2 <2.11.0": "2.11.0"
    }
  }
}
