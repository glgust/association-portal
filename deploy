  config_write_line "$DEPLOY_CONFIG_TMP" MEDIA_S3_BUCKET "$DEPLOY_INIT_S3_BUCKET"
  config_write_line "$DEPLOY_CONFIG_TMP" MEDIA_S3_ACCESS_KEY_ID "$DEPLOY_INIT_S3_ACCESS"
  config_write_line "$DEPLOY_CONFIG_TMP" MEDIA_S3_SECRET_ACCESS_KEY "$DEPLOY_INIT_S3_SECRET"
  config_write_line "$DEPLOY_CONFIG_TMP" MEDIA_S3_FORCE_PATH_STYLE "$DEPLOY_INIT_S3_PATH_STYLE"
  config_write_line "$DEPLOY_CONFIG_TMP" MINIO_ROOT_USER "$DEPLOY_INIT_MINIO_ROOT_USER"
  config_write_line "$DEPLOY_CONFIG_TMP" MINIO_ROOT_PASSWORD "$DEPLOY_INIT_MINIO_ROOT_PASSWORD"
  config_write_line "$DEPLOY_CONFIG_TMP" CMS_API_URL "$DEPLOY_INIT_CMS_API_URL"
  config_write_line "$DEPLOY_CONFIG_TMP" DEMO_ADMIN_USERNAME "$DEPLOY_INIT_DEMO_ADMIN_USERNAME"
  config_write_line "$DEPLOY_CONFIG_TMP" DEMO_ADMIN_PASSWORD "$DEPLOY_INIT_DEMO_ADMIN_PASSWORD"
  config_write_line "$DEPLOY_CONFIG_TMP" DEMO_STAFF_USERNAME "$DEPLOY_INIT_DEMO_STAFF_USERNAME"
