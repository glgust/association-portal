# This is a non-secret reference. Run ./deploy init to create .ascnucc/deploy.env.
ASCNUCC_CONFIG_SCHEMA=1
ASCNUCC_DEPLOYMENT_ID=replace-with-generated-id
ASCNUCC_COMPOSE_PROJECT=replace-with-generated-project
ASCNUCC_ENVIRONMENT=production
ASCNUCC_ROLES=web,cms,data
ASCNUCC_RELEASE=v1.0.0
ASCNUCC_IMAGE_OWNER=YOUR_GITHUB_ACCOUNT
ASCNUCC_APP_BIND_IP=127.0.0.1
ASCNUCC_DATA_BIND_IP=127.0.0.1
ASCNUCC_WEB_PORT=3000
ASCNUCC_CMS_PORT=3001
ASCNUCC_POSTGRES_PORT=5432
ASCNUCC_MINIO_PORT=9000
ASCNUCC_MINIO_CONSOLE_PORT=9001
ASCNUCC_DATA_STORAGE=docker
# Secrets and role-specific connection values are generated or requested by init.
