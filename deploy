#!/bin/sh

set -eu

umask 077

DEPLOY_SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
DEPLOY_COMPOSE_FILE="$DEPLOY_SCRIPT_DIR/compose.deploy.yaml"
DEPLOY_CONFIG_DIR=${ASCNUCC_CONFIG_DIR:-"$DEPLOY_SCRIPT_DIR/.ascnucc"}
DEPLOY_CONFIG_FILE="$DEPLOY_CONFIG_DIR/deploy.env"
DEPLOY_STATE_FILE="$DEPLOY_CONFIG_DIR/state.env"
DEPLOY_DOCKER_CONFIG_DIR="$DEPLOY_CONFIG_DIR/docker"
DEPLOY_LOCK_DIR="$DEPLOY_CONFIG_DIR/update.lock"
DEPLOY_SCHEMA=1
DEPLOY_MIN_COMPOSE_MAJOR=2
DEPLOY_MIN_COMPOSE_MINOR=24

say() {
  printf '%s\n' "$*"
}

step() {
  printf '\n==> %s\n' "$*"
}

warn() {
  printf 'WARN: %s\n' "$*" >&2
}

fail() {
  printf 'ERROR: %s\n' "$1" >&2
  if [ "$#" -gt 1 ]; then
    printf 'NEXT: %s\n' "$2" >&2
  fi
  exit 1
}

require_interactive() {
  [ -t 0 ] || fail "This operation needs an interactive terminal." "Run the same command from a terminal."
}

prompt_default() {
  DEPLOY_PROMPT_LABEL=$1
  DEPLOY_PROMPT_DEFAULT=$2
  printf '%s [%s]: ' "$DEPLOY_PROMPT_LABEL" "$DEPLOY_PROMPT_DEFAULT" >&2
  IFS= read -r DEPLOY_PROMPT_REPLY
  if [ -n "$DEPLOY_PROMPT_REPLY" ]; then
    printf '%s' "$DEPLOY_PROMPT_REPLY"
  else
    printf '%s' "$DEPLOY_PROMPT_DEFAULT"
  fi
}

prompt_optional() {
  DEPLOY_PROMPT_LABEL=$1
  printf '%s: ' "$DEPLOY_PROMPT_LABEL" >&2
  IFS= read -r DEPLOY_PROMPT_REPLY
  printf '%s' "$DEPLOY_PROMPT_REPLY"
}

prompt_secret() {
  DEPLOY_PROMPT_LABEL=$1
  printf '%s: ' "$DEPLOY_PROMPT_LABEL" >&2
  stty -echo
  trap 'stty echo' EXIT HUP INT TERM
  IFS= read -r DEPLOY_PROMPT_REPLY
  stty echo
  trap - EXIT HUP INT TERM
  printf '\n' >&2
  printf '%s' "$DEPLOY_PROMPT_REPLY"
}

prompt_yes_no() {
  DEPLOY_PROMPT_LABEL=$1
  DEPLOY_PROMPT_DEFAULT=$2
  if [ "$DEPLOY_PROMPT_DEFAULT" = yes ]; then
    DEPLOY_PROMPT_SUFFIX='Y/n'
  else
    DEPLOY_PROMPT_SUFFIX='y/N'
  fi
  printf '%s [%s]: ' "$DEPLOY_PROMPT_LABEL" "$DEPLOY_PROMPT_SUFFIX" >&2
  IFS= read -r DEPLOY_PROMPT_REPLY
  case "$DEPLOY_PROMPT_REPLY" in
    y|Y|yes|YES) return 0 ;;
    n|N|no|NO) return 1 ;;
    '') [ "$DEPLOY_PROMPT_DEFAULT" = yes ] ;;
    *) return 1 ;;
  esac
}

random_hex() {
  DEPLOY_RANDOM_BYTES=$1
  od -An -N "$DEPLOY_RANDOM_BYTES" -tx1 /dev/urandom | tr -d ' \n'
}

config_write_line() {
  DEPLOY_CONFIG_TARGET=$1
  DEPLOY_CONFIG_KEY=$2
  DEPLOY_CONFIG_VALUE=$3
  case "$DEPLOY_CONFIG_VALUE" in
    *"
"*) fail "A configuration value contains a newline." "Run ./deploy init again with a single-line value." ;;
  esac
  printf '%s=%s\n' "$DEPLOY_CONFIG_KEY" "$DEPLOY_CONFIG_VALUE" >> "$DEPLOY_CONFIG_TARGET"
}

load_env_file() {
  DEPLOY_ENV_FILE=$1
  [ -f "$DEPLOY_ENV_FILE" ] || return 0
  while IFS= read -r DEPLOY_ENV_LINE || [ -n "$DEPLOY_ENV_LINE" ]; do
    DEPLOY_ENV_LINE=$(printf '%s' "$DEPLOY_ENV_LINE" | tr -d '\r')
    case "$DEPLOY_ENV_LINE" in
      ''|'#'*) continue ;;
      *=*) ;;
      *) fail "Invalid configuration line in $DEPLOY_ENV_FILE." "Run ./deploy init to repair the configuration." ;;
    esac
    DEPLOY_ENV_KEY=${DEPLOY_ENV_LINE%%=*}
    DEPLOY_ENV_VALUE=${DEPLOY_ENV_LINE#*=}
    case "$DEPLOY_ENV_KEY" in
      ASCNUCC_*|CMS_API_URL|DATABASE_URL|PAYLOAD_SECRET|MEDIA_S3_*|POSTGRES_*|MINIO_*|DEMO_*)
        export "$DEPLOY_ENV_KEY=$DEPLOY_ENV_VALUE"
        ;;
      *)
        fail "Unsupported configuration key: $DEPLOY_ENV_KEY" "Remove the unknown key or run ./deploy init with the matching release bundle."
        ;;
    esac
  done < "$DEPLOY_ENV_FILE"
}

load_configuration() {
  [ -f "$DEPLOY_CONFIG_FILE" ] || fail "Deployment is not initialized." "Run ./deploy init"
  load_env_file "$DEPLOY_CONFIG_FILE"
  load_env_file "$DEPLOY_STATE_FILE"
}

has_role() {
  case ",${ASCNUCC_ROLES:-}," in
    *",$1,"*) return 0 ;;
    *) return 1 ;;
  esac
}

normalize_roles() {
  DEPLOY_ROLE_INPUT=$(printf '%s' "$1" | tr -d ' ')
  [ "$DEPLOY_ROLE_INPUT" != all ] || DEPLOY_ROLE_INPUT=web,cms,data
  case "$DEPLOY_ROLE_INPUT" in
    ''|,*|*,|*,,*) fail "Invalid deployment role list: $1" "Use all, web, cms, data, or a comma-separated combination." ;;
  esac
  DEPLOY_ROLE_OUTPUT=
  DEPLOY_ROLE_OLD_IFS=$IFS
  IFS=,
  for DEPLOY_ROLE_NAME in $DEPLOY_ROLE_INPUT; do
    case "$DEPLOY_ROLE_NAME" in
      web|cms|data) ;;
      *)
        IFS=$DEPLOY_ROLE_OLD_IFS
        fail "Unknown deployment role: $DEPLOY_ROLE_NAME" "Use all, web, cms, data, or a comma-separated combination."
        ;;
    esac
  done
  IFS=$DEPLOY_ROLE_OLD_IFS
  for DEPLOY_ROLE_NAME in web cms data; do
    case ",$DEPLOY_ROLE_INPUT," in
      *",$DEPLOY_ROLE_NAME,"*)
        if [ -n "$DEPLOY_ROLE_OUTPUT" ]; then DEPLOY_ROLE_OUTPUT="$DEPLOY_ROLE_OUTPUT,$DEPLOY_ROLE_NAME"; else DEPLOY_ROLE_OUTPUT=$DEPLOY_ROLE_NAME; fi
        ;;
    esac
  done
  [ -n "$DEPLOY_ROLE_OUTPUT" ] || fail "At least one deployment role is required." "Use all, web, cms, or data."
  printf '%s' "$DEPLOY_ROLE_OUTPUT"
}

valid_environment() {
  [ "$1" = production ] || [ "$1" = demo ]
}

valid_release() {
  [ "$1" = latest ] && return 0
  printf '%s' "$1" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$'
}

release_tag() {
  if [ "$1" = latest ]; then
    printf 'stable'
  else
    printf '%s' "$1"
  fi
}

valid_port() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_ipv4() {
  printf '%s\n' "$1" | awk -F. '
    NF != 4 { exit 1 }
    {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
      }
    }
  '
}

validate_custom_data_root() {
  DEPLOY_DATA_ROOT=$1
  case "$DEPLOY_DATA_ROOT" in
    /*) ;;
    *) fail "Custom data directory must be absolute." "Choose a dedicated absolute directory such as /srv/ascnucc-data." ;;
  esac
  case "$DEPLOY_DATA_ROOT" in
    /|/home|/root|/var|/srv|/opt|/usr|/etc|/tmp)
      fail "The selected data directory is too broad: $DEPLOY_DATA_ROOT" "Choose a dedicated child directory such as /srv/ascnucc-data."
      ;;
    *'/../'*|*/..|*'/./'*)
      fail "The selected data directory is not normalized." "Use an absolute path without . or .. segments."
      ;;
  esac
  case "$DEPLOY_DATA_ROOT" in
    "$DEPLOY_SCRIPT_DIR"|"$DEPLOY_SCRIPT_DIR"/*)
      fail "The repository or deployment bundle cannot be used as a data directory." "Choose a dedicated directory outside $DEPLOY_SCRIPT_DIR."
      ;;
  esac
}

docker_cli() {
  if [ "${ASCNUCC_REGISTRY_AUTH_MODE:-dedicated}" = dedicated ]; then
    command docker --config "$DEPLOY_DOCKER_CONFIG_DIR" "$@"
  else
    command docker "$@"
  fi
}

set_compose_scope() {
  DEPLOY_PROFILE_ARGS=
  DEPLOY_SELECTED_SERVICES=
  if has_role web; then
    DEPLOY_PROFILE_ARGS="$DEPLOY_PROFILE_ARGS --profile web"
    DEPLOY_SELECTED_SERVICES="$DEPLOY_SELECTED_SERVICES web"
  fi
  if has_role cms; then
    DEPLOY_PROFILE_ARGS="$DEPLOY_PROFILE_ARGS --profile cms"
    DEPLOY_SELECTED_SERVICES="$DEPLOY_SELECTED_SERVICES cms"
  fi
  if has_role data; then
    DEPLOY_PROFILE_ARGS="$DEPLOY_PROFILE_ARGS --profile data"
    DEPLOY_SELECTED_SERVICES="$DEPLOY_SELECTED_SERVICES postgres minio"
  fi
}

compose_cmd() {
  set_compose_scope
  # DEPLOY_PROFILE_ARGS contains only fixed profile switches assembled above.
  # shellcheck disable=SC2086
  docker_cli compose --env-file "$DEPLOY_CONFIG_FILE" -p "$ASCNUCC_COMPOSE_PROJECT" -f "$DEPLOY_COMPOSE_FILE" $DEPLOY_PROFILE_ARGS "$@"
}

redact_stream() {
  awk '
    function literal_replace(text, needle, replacement, result, pos) {
      if (needle == "") return text
      result = ""
      while ((pos = index(text, needle)) > 0) {
        result = result substr(text, 1, pos - 1) replacement
        text = substr(text, pos + length(needle))
      }
      return result text
    }
    {
      line = $0
      line = literal_replace(line, ENVIRON["PAYLOAD_SECRET"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["POSTGRES_PASSWORD"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["MINIO_ROOT_PASSWORD"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["MEDIA_S3_SECRET_ACCESS_KEY"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["MEDIA_S3_ACCESS_KEY_ID"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["DEMO_ADMIN_PASSWORD"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["DEMO_STAFF_PASSWORD"], "[REDACTED]")
      line = literal_replace(line, ENVIRON["DEMO_CADRE_PASSWORD"], "[REDACTED]")
      gsub(/:\/\/[^[:space:]\/@:]+:[^[:space:]\/@]+@/, "://[REDACTED]@", line)
      print line
    }
  '
}

detect_registry_auth_mode() {
  DEPLOY_SYSTEM_DOCKER_CONFIG=${DOCKER_CONFIG:-"${HOME:-}/.docker"}
  if [ -n "${HOME:-}" ] && [ -f "$DEPLOY_SYSTEM_DOCKER_CONFIG/config.json" ] && \
    grep -Eq '"(credsStore|credHelpers)"[[:space:]]*:' "$DEPLOY_SYSTEM_DOCKER_CONFIG/config.json"; then
    printf 'system'
  else
    printf 'dedicated'
  fi
}

image_reference() {
  DEPLOY_IMAGE_COMPONENT=$1
  DEPLOY_IMAGE_RELEASE=$2
  DEPLOY_IMAGE_TAG=$(release_tag "$DEPLOY_IMAGE_RELEASE")
  printf 'ghcr.io/%s/association-portal-%s:%s' "$ASCNUCC_IMAGE_OWNER" "$DEPLOY_IMAGE_COMPONENT" "$DEPLOY_IMAGE_TAG"
}

registry_access_ok() {
  DEPLOY_REGISTRY_COMPONENT=$1
  DEPLOY_REGISTRY_RELEASE=${ASCNUCC_ACTIVE_RELEASE_REQUEST:-$ASCNUCC_RELEASE}
  DEPLOY_REGISTRY_REF=$(image_reference "$DEPLOY_REGISTRY_COMPONENT" "$DEPLOY_REGISTRY_RELEASE")
  docker_cli manifest inspect "$DEPLOY_REGISTRY_REF" >/dev/null 2>&1
}

ensure_registry_login() {
  if ! has_role web && ! has_role cms; then
    return 0
  fi
  DEPLOY_LOGIN_COMPONENT=web
  has_role web || DEPLOY_LOGIN_COMPONENT=cms
  if registry_access_ok "$DEPLOY_LOGIN_COMPONENT"; then
    say 'Private GHCR access is ready.'
    return 0
  fi
  require_interactive
  step 'Private GHCR login'
  say 'Create a GitHub PAT (classic) with read:packages only; the token is not stored in deploy.env.'
  DEPLOY_REGISTRY_TOKEN=$(prompt_secret 'GHCR read-only token')
  [ -n "$DEPLOY_REGISTRY_TOKEN" ] || fail "The GHCR token cannot be empty." "Run ./deploy init and provide a read:packages token."
  if [ "$ASCNUCC_REGISTRY_AUTH_MODE" = dedicated ]; then
    mkdir -p "$DEPLOY_DOCKER_CONFIG_DIR"
    chmod 700 "$DEPLOY_DOCKER_CONFIG_DIR"
  fi
  if ! printf '%s' "$DEPLOY_REGISTRY_TOKEN" | docker_cli login ghcr.io --username "$ASCNUCC_REGISTRY_USERNAME" --password-stdin >/dev/null 2>&1; then
    DEPLOY_REGISTRY_TOKEN=
    fail "GHCR authentication failed." "Run ./deploy init and verify the username, token expiry, read:packages scope, and package Read access."
  fi
  DEPLOY_REGISTRY_TOKEN=
  if [ "$ASCNUCC_REGISTRY_AUTH_MODE" = dedicated ] && [ -f "$DEPLOY_DOCKER_CONFIG_DIR/config.json" ]; then
    chmod 600 "$DEPLOY_DOCKER_CONFIG_DIR/config.json"
  fi
  registry_access_ok "$DEPLOY_LOGIN_COMPONENT" || fail "GHCR login succeeded but the selected release is not readable." "Check package Read access or choose an existing Release."
  say 'Private GHCR access is ready.'
}

init_command() {
  require_interactive
  if [ -f "$DEPLOY_CONFIG_FILE" ]; then
    load_configuration
    step 'Existing deployment configuration'
    say "Deployment: $ASCNUCC_DEPLOYMENT_ID"
    say "Roles: $ASCNUCC_ROLES"
    say "Release target: $ASCNUCC_RELEASE"
    ensure_registry_login
    probe_command
    say 'Configuration kept unchanged. Next: ./deploy up'
    return 0
  fi

  step 'ASCNUCC deployment initialization'
  say 'Press Enter to accept safe defaults. Secrets are generated locally and never printed.'
  DEPLOY_INIT_ROLES=$(prompt_default 'Roles (all/web/cms/data or a comma-separated combination)' all)
  DEPLOY_INIT_ROLES=$(normalize_roles "$DEPLOY_INIT_ROLES")
  ASCNUCC_ROLES=$DEPLOY_INIT_ROLES
  export ASCNUCC_ROLES

  DEPLOY_INIT_ENVIRONMENT=$(prompt_default 'Environment (production/demo)' demo)
  valid_environment "$DEPLOY_INIT_ENVIRONMENT" || fail "Environment must be production or demo." "Run ./deploy init again."

  DEPLOY_INIT_RELEASE=v1.0.0
  DEPLOY_INIT_OWNER=YOUR_GITHUB_ACCOUNT
  DEPLOY_INIT_REGISTRY_USERNAME=YOUR_GITHUB_ACCOUNT
  DEPLOY_INIT_AUTH_MODE=$(detect_registry_auth_mode)
  if has_role web || has_role cms; then
    DEPLOY_INIT_RELEASE=$(prompt_default 'Release (latest or an exact version such as v1.0.0)' v1.0.0)
    valid_release "$DEPLOY_INIT_RELEASE" || fail "Release must be latest or a semantic version such as v1.0.0." "Run ./deploy init again."
    DEPLOY_INIT_OWNER=$(prompt_default 'GHCR image owner' YOUR_GITHUB_ACCOUNT)
    [ "$DEPLOY_INIT_OWNER" != YOUR_GITHUB_ACCOUNT ] || fail "Enter the actual owner of the open-source GHCR images." "Run ./deploy init again."
    DEPLOY_INIT_REGISTRY_USERNAME=$(prompt_default 'GitHub username used to pull private images' YOUR_GITHUB_ACCOUNT)
  fi

  DEPLOY_INIT_APP_BIND=127.0.0.1
  if has_role web || has_role cms; then
    DEPLOY_INIT_APP_BIND=$(prompt_default 'Application bind IPv4 (loopback, Tailscale, or trusted LAN address)' 127.0.0.1)
    valid_ipv4 "$DEPLOY_INIT_APP_BIND" || fail "Application bind address must be IPv4." "Run ./deploy init again with a local IPv4 address."
  fi

  DEPLOY_INIT_DATA_BIND=127.0.0.1
  DEPLOY_INIT_DATA_STORAGE=docker
  DEPLOY_INIT_DATA_ROOT=
  if has_role data; then
    if prompt_yes_no 'Will another machine connect directly to PostgreSQL or MinIO?' no; then
      DEPLOY_INIT_DATA_BIND=$(prompt_default 'Data bind IPv4 (Tailscale recommended)' 127.0.0.1)
      valid_ipv4 "$DEPLOY_INIT_DATA_BIND" || fail "Data bind address must be IPv4." "Run ./deploy init again with a local IPv4 address."
      warn 'Data services do not add transport TLS; use Tailscale or a separately secured trusted network.'
    fi
    if prompt_yes_no 'Use a custom host data directory instead of Docker-managed volumes?' no; then
      DEPLOY_INIT_DATA_STORAGE=bind
      DEPLOY_INIT_DATA_ROOT=$(prompt_default 'Dedicated data directory' "/srv/ascnucc-$DEPLOY_INIT_ENVIRONMENT")
      validate_custom_data_root "$DEPLOY_INIT_DATA_ROOT"
      mkdir -p "$DEPLOY_INIT_DATA_ROOT/postgres" "$DEPLOY_INIT_DATA_ROOT/minio"
      chmod 700 "$DEPLOY_INIT_DATA_ROOT" "$DEPLOY_INIT_DATA_ROOT/postgres" "$DEPLOY_INIT_DATA_ROOT/minio"
    fi
  fi

  DEPLOY_INIT_WEB_PORT=3000
  DEPLOY_INIT_CMS_PORT=3001
  DEPLOY_INIT_POSTGRES_PORT=5432
  DEPLOY_INIT_MINIO_PORT=9000
  DEPLOY_INIT_MINIO_CONSOLE_PORT=9001
  if prompt_yes_no 'Customize service ports?' no; then
    has_role web && DEPLOY_INIT_WEB_PORT=$(prompt_default 'Web port' 3000)
    has_role cms && DEPLOY_INIT_CMS_PORT=$(prompt_default 'CMS port' 3001)
    if has_role data; then
      DEPLOY_INIT_POSTGRES_PORT=$(prompt_default 'PostgreSQL port' 5432)
      DEPLOY_INIT_MINIO_PORT=$(prompt_default 'MinIO API port' 9000)
      DEPLOY_INIT_MINIO_CONSOLE_PORT=$(prompt_default 'MinIO console port' 9001)
    fi
  fi
  for DEPLOY_INIT_PORT in "$DEPLOY_INIT_WEB_PORT" "$DEPLOY_INIT_CMS_PORT" "$DEPLOY_INIT_POSTGRES_PORT" "$DEPLOY_INIT_MINIO_PORT" "$DEPLOY_INIT_MINIO_CONSOLE_PORT"; do
    valid_port "$DEPLOY_INIT_PORT" || fail "Port is outside 1-65535: $DEPLOY_INIT_PORT" "Run ./deploy init again."
  done
  DEPLOY_INIT_PORTS=" $DEPLOY_INIT_WEB_PORT $DEPLOY_INIT_CMS_PORT $DEPLOY_INIT_POSTGRES_PORT $DEPLOY_INIT_MINIO_PORT $DEPLOY_INIT_MINIO_CONSOLE_PORT "
  DEPLOY_INIT_UNIQUE_PORTS=$(printf '%s\n' $DEPLOY_INIT_PORTS | sort -u | wc -l | tr -d ' ')
  [ "$DEPLOY_INIT_UNIQUE_PORTS" -eq 5 ] || fail "Service ports must be distinct." "Run ./deploy init again with unique ports."

  DEPLOY_INIT_ID="ascnucc-$(random_hex 6)"
  DEPLOY_INIT_PROJECT=$(printf '%s' "$DEPLOY_INIT_ID" | tr '-' '_')
  DEPLOY_INIT_DATABASE_URL=
  DEPLOY_INIT_POSTGRES_DB=
  DEPLOY_INIT_POSTGRES_USER=
  DEPLOY_INIT_POSTGRES_PASSWORD=
  DEPLOY_INIT_PAYLOAD_SECRET=
  DEPLOY_INIT_S3_ENDPOINT=
  DEPLOY_INIT_S3_REGION=
  DEPLOY_INIT_S3_BUCKET=
  DEPLOY_INIT_S3_ACCESS=
  DEPLOY_INIT_S3_SECRET=
  DEPLOY_INIT_S3_PATH_STYLE=false
  DEPLOY_INIT_MINIO_ROOT_USER=
  DEPLOY_INIT_MINIO_ROOT_PASSWORD=
  DEPLOY_INIT_CMS_API_URL=
  DEPLOY_INIT_DEMO_ADMIN_USERNAME=
  DEPLOY_INIT_DEMO_ADMIN_PASSWORD=
  DEPLOY_INIT_DEMO_STAFF_USERNAME=
  DEPLOY_INIT_DEMO_STAFF_PASSWORD=
  DEPLOY_INIT_DEMO_CADRE_USERNAME=
  DEPLOY_INIT_DEMO_CADRE_PASSWORD=

  if has_role cms; then
    DEPLOY_INIT_PAYLOAD_SECRET=$(random_hex 48)
    if has_role data; then
      DEPLOY_INIT_POSTGRES_DB=ascnucc
      [ "$DEPLOY_INIT_ENVIRONMENT" != demo ] || DEPLOY_INIT_POSTGRES_DB=ascnucc_demo_dev
      DEPLOY_INIT_POSTGRES_USER=ascnucc
      DEPLOY_INIT_POSTGRES_PASSWORD=$(random_hex 32)
      DEPLOY_INIT_DATABASE_URL="postgres://$DEPLOY_INIT_POSTGRES_USER:$DEPLOY_INIT_POSTGRES_PASSWORD@postgres:5432/$DEPLOY_INIT_POSTGRES_DB"
      DEPLOY_INIT_S3_ENDPOINT=http://minio:9000
      DEPLOY_INIT_S3_REGION=us-east-1
      DEPLOY_INIT_S3_BUCKET=ascnucc-media
      DEPLOY_INIT_S3_ACCESS="ascnucc-$(random_hex 12)"
      DEPLOY_INIT_S3_SECRET=$(random_hex 32)
      DEPLOY_INIT_S3_PATH_STYLE=true
      DEPLOY_INIT_MINIO_ROOT_USER="root-$(random_hex 12)"
      DEPLOY_INIT_MINIO_ROOT_PASSWORD=$(random_hex 32)
    else
      DEPLOY_INIT_DATABASE_URL=$(prompt_secret 'External PostgreSQL DATABASE_URL')
      DEPLOY_INIT_S3_ENDPOINT=$(prompt_default 'Private S3 endpoint' https://s3.example.invalid)
      DEPLOY_INIT_S3_REGION=$(prompt_default 'S3 region' us-east-1)
      DEPLOY_INIT_S3_BUCKET=$(prompt_default 'Private S3 bucket' ascnucc-media)
      DEPLOY_INIT_S3_ACCESS=$(prompt_secret 'S3 access key ID')
      DEPLOY_INIT_S3_SECRET=$(prompt_secret 'S3 secret access key')
      case "$DEPLOY_INIT_DATABASE_URL" in postgres://*|postgresql://*) ;; *) fail "External DATABASE_URL must use postgres:// or postgresql://." "Run ./deploy init again." ;; esac
      case "$DEPLOY_INIT_S3_ENDPOINT" in http://*|https://*) ;; *) fail "S3 endpoint must be an absolute HTTP(S) URL." "Run ./deploy init again." ;; esac
      [ -n "$DEPLOY_INIT_S3_ACCESS" ] && [ -n "$DEPLOY_INIT_S3_SECRET" ] || fail "External S3 credentials cannot be empty." "Run ./deploy init again."
      if prompt_yes_no 'Use S3 path-style addressing?' no; then DEPLOY_INIT_S3_PATH_STYLE=true; fi
    fi
  elif has_role data; then
    DEPLOY_INIT_POSTGRES_DB=ascnucc
    [ "$DEPLOY_INIT_ENVIRONMENT" != demo ] || DEPLOY_INIT_POSTGRES_DB=ascnucc_demo_dev
    DEPLOY_INIT_POSTGRES_USER=ascnucc
    DEPLOY_INIT_POSTGRES_PASSWORD=$(random_hex 32)
    DEPLOY_INIT_S3_REGION=us-east-1
    DEPLOY_INIT_S3_BUCKET=ascnucc-media
    DEPLOY_INIT_S3_ACCESS="ascnucc-$(random_hex 12)"
    DEPLOY_INIT_S3_SECRET=$(random_hex 32)
    DEPLOY_INIT_MINIO_ROOT_USER="root-$(random_hex 12)"
    DEPLOY_INIT_MINIO_ROOT_PASSWORD=$(random_hex 32)
  fi

  if has_role web; then
    if has_role cms; then
      DEPLOY_INIT_CMS_API_URL=http://cms:3001
    else
      DEPLOY_INIT_CMS_API_URL=$(prompt_default 'External CMS API URL' https://cms.example.invalid)
      case "$DEPLOY_INIT_CMS_API_URL" in http://*|https://*) ;; *) fail "CMS API URL must be an absolute HTTP(S) URL." "Run ./deploy init again." ;; esac
    fi
  fi

  if [ "$DEPLOY_INIT_ENVIRONMENT" = demo ] && has_role cms && has_role data; then
    DEPLOY_INIT_DEMO_ADMIN_USERNAME=demo-owner
    DEPLOY_INIT_DEMO_ADMIN_PASSWORD=$(random_hex 24)
    DEPLOY_INIT_DEMO_STAFF_USERNAME=demo-staff
    DEPLOY_INIT_DEMO_STAFF_PASSWORD=$(random_hex 24)
    DEPLOY_INIT_DEMO_CADRE_USERNAME=demo-cadre
    DEPLOY_INIT_DEMO_CADRE_PASSWORD=$(random_hex 24)
  fi

  mkdir -p "$DEPLOY_CONFIG_DIR"
  chmod 700 "$DEPLOY_CONFIG_DIR"
  DEPLOY_CONFIG_TMP="$DEPLOY_CONFIG_DIR/deploy.env.new.$$"
  : > "$DEPLOY_CONFIG_TMP"
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_CONFIG_SCHEMA "$DEPLOY_SCHEMA"
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_DEPLOYMENT_ID "$DEPLOY_INIT_ID"
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_COMPOSE_PROJECT "$DEPLOY_INIT_PROJECT"
  config_write_line "$DEPLOY_CONFIG_TMP" ASCNUCC_ENVIRONMENT "$DEPLOY_INIT_ENVIRONMENT"
