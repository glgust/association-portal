  config_write_line "$DEPLOY_CONFIG_TMP" DEMO_CADRE_USERNAME "$DEPLOY_INIT_DEMO_CADRE_USERNAME"
  config_write_line "$DEPLOY_CONFIG_TMP" DEMO_CADRE_PASSWORD "$DEPLOY_INIT_DEMO_CADRE_PASSWORD"
  chmod 600 "$DEPLOY_CONFIG_TMP"
  mv "$DEPLOY_CONFIG_TMP" "$DEPLOY_CONFIG_FILE"

  load_configuration
  ensure_registry_login
  probe_command
  say 'Initialization complete. Next: ./deploy up'
}

add_probe_error() {
  DEPLOY_PROBE_ERRORS=$((DEPLOY_PROBE_ERRORS + 1))
  DEPLOY_PROBE_ERROR_TEXT="$DEPLOY_PROBE_ERROR_TEXT\n  - $*"
}

add_probe_warning() {
  DEPLOY_PROBE_WARNINGS=$((DEPLOY_PROBE_WARNINGS + 1))
  DEPLOY_PROBE_WARNING_TEXT="$DEPLOY_PROBE_WARNING_TEXT\n  - $*"
}

compose_version_ok() {
  DEPLOY_COMPOSE_VERSION=$(docker compose version --short 2>/dev/null | sed 's/^v//;s/[^0-9.].*$//') || return 1
  DEPLOY_COMPOSE_MAJOR=${DEPLOY_COMPOSE_VERSION%%.*}
  DEPLOY_COMPOSE_REST=${DEPLOY_COMPOSE_VERSION#*.}
  DEPLOY_COMPOSE_MINOR=${DEPLOY_COMPOSE_REST%%.*}
  case "$DEPLOY_COMPOSE_MAJOR:$DEPLOY_COMPOSE_MINOR" in
    *[!0-9:]*|:) return 1 ;;
  esac
  [ "$DEPLOY_COMPOSE_MAJOR" -gt "$DEPLOY_MIN_COMPOSE_MAJOR" ] || {
    [ "$DEPLOY_COMPOSE_MAJOR" -eq "$DEPLOY_MIN_COMPOSE_MAJOR" ] && [ "$DEPLOY_COMPOSE_MINOR" -ge "$DEPLOY_MIN_COMPOSE_MINOR" ]
  }
}

ip_is_local() {
  DEPLOY_CHECK_IP=$1
  case "$DEPLOY_CHECK_IP" in
    127.*) return 0 ;;
  esac
  if command -v ip >/dev/null 2>&1; then
    ip -o -4 address show 2>/dev/null | awk -v target="$DEPLOY_CHECK_IP" '{ split($4, value, "/"); if (value[1] == target) found=1 } END { exit found ? 0 : 1 }'
    return $?
  fi
  if command -v hostname >/dev/null 2>&1; then
    for DEPLOY_LOCAL_IP in $(hostname -I 2>/dev/null || true); do
      [ "$DEPLOY_LOCAL_IP" != "$DEPLOY_CHECK_IP" ] || return 0
    done
  fi
  return 1
}

port_is_listening() {
  DEPLOY_CHECK_PORT=$1
  DEPLOY_CHECK_HEX=$(printf '%04X' "$DEPLOY_CHECK_PORT")
  awk -v port=":$DEPLOY_CHECK_HEX" '$2 ~ port"$" && $4 == "0A" { found=1 } END { exit found ? 0 : 1 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

port_owned_by_deployment() {
  DEPLOY_CHECK_PORT=$1
  docker ps --filter "label=io.ascnucc.deployment-id=$ASCNUCC_DEPLOYMENT_ID" --format '{{.Ports}}' 2>/dev/null | grep -Eq "[:.]$DEPLOY_CHECK_PORT->"
}

check_port() {
  DEPLOY_CHECK_PORT=$1
  DEPLOY_CHECK_NAME=$2
  if port_is_listening "$DEPLOY_CHECK_PORT" && ! port_owned_by_deployment "$DEPLOY_CHECK_PORT"; then
    add_probe_error "$DEPLOY_CHECK_NAME port $DEPLOY_CHECK_PORT is already in use by another process."
  fi
}

check_free_space() {
  DEPLOY_SPACE_PATH=$1
  DEPLOY_SPACE_NAME=$2
  DEPLOY_SPACE_KB=$(df -Pk "$DEPLOY_SPACE_PATH" 2>/dev/null | awk 'NR == 2 { print $4 }')
  case "$DEPLOY_SPACE_KB" in
    ''|*[!0-9]*) add_probe_warning "Could not determine free space for $DEPLOY_SPACE_NAME." ;;
    *)
      if [ "$DEPLOY_SPACE_KB" -lt 1048576 ]; then
        add_probe_error "$DEPLOY_SPACE_NAME has less than 1 GiB free."
      elif [ "$DEPLOY_SPACE_KB" -lt 5242880 ]; then
        add_probe_warning "$DEPLOY_SPACE_NAME has less than 5 GiB free."
      fi
      ;;
  esac
}

tcp_reachable() {
  DEPLOY_TCP_HOST=$1
  DEPLOY_TCP_PORT=$2
  if command -v nc >/dev/null 2>&1; then
    nc -z -w 4 "$DEPLOY_TCP_HOST" "$DEPLOY_TCP_PORT" >/dev/null 2>&1
    return $?
  fi
  if command -v bash >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    DEPLOY_TCP_HOST=$DEPLOY_TCP_HOST DEPLOY_TCP_PORT=$DEPLOY_TCP_PORT timeout 5 bash -c 'exec 3<>"/dev/tcp/$DEPLOY_TCP_HOST/$DEPLOY_TCP_PORT"' >/dev/null 2>&1
    return $?
  fi
  return 2
}

url_host_port() {
  DEPLOY_URL_VALUE=$1
  DEPLOY_URL_DEFAULT_PORT=$2
  DEPLOY_URL_AUTHORITY=${DEPLOY_URL_VALUE#*://}
  DEPLOY_URL_AUTHORITY=${DEPLOY_URL_AUTHORITY%%/*}
  DEPLOY_URL_HOSTPORT=${DEPLOY_URL_AUTHORITY##*@}
  DEPLOY_URL_HOST=${DEPLOY_URL_HOSTPORT%%:*}
  DEPLOY_URL_PORT=${DEPLOY_URL_HOSTPORT##*:}
  [ "$DEPLOY_URL_PORT" != "$DEPLOY_URL_HOSTPORT" ] || DEPLOY_URL_PORT=$DEPLOY_URL_DEFAULT_PORT
  printf '%s %s' "$DEPLOY_URL_HOST" "$DEPLOY_URL_PORT"
}

check_external_url() {
  DEPLOY_EXTERNAL_VALUE=$1
  DEPLOY_EXTERNAL_DEFAULT_PORT=$2
  DEPLOY_EXTERNAL_NAME=$3
  DEPLOY_EXTERNAL_PAIR=$(url_host_port "$DEPLOY_EXTERNAL_VALUE" "$DEPLOY_EXTERNAL_DEFAULT_PORT")
  DEPLOY_EXTERNAL_HOST=${DEPLOY_EXTERNAL_PAIR%% *}
  DEPLOY_EXTERNAL_PORT=${DEPLOY_EXTERNAL_PAIR##* }
  if [ -z "$DEPLOY_EXTERNAL_HOST" ] || ! valid_port "$DEPLOY_EXTERNAL_PORT"; then
    add_probe_error "$DEPLOY_EXTERNAL_NAME URL is invalid."
    return
  fi
  if tcp_reachable "$DEPLOY_EXTERNAL_HOST" "$DEPLOY_EXTERNAL_PORT"; then
    return
  else
    DEPLOY_EXTERNAL_STATUS=$?
  fi
  if [ "$DEPLOY_EXTERNAL_STATUS" -eq 2 ]; then
    add_probe_warning "$DEPLOY_EXTERNAL_NAME connectivity could not be checked because neither nc nor bash+timeout is available."
  else
    add_probe_error "$DEPLOY_EXTERNAL_NAME is not reachable at $DEPLOY_EXTERNAL_HOST:$DEPLOY_EXTERNAL_PORT."
  fi
}

check_container_ownership() {
  DEPLOY_OWNERSHIP_LINES=$(docker ps -a --filter "label=com.docker.compose.project=$ASCNUCC_COMPOSE_PROJECT" --format '{{.ID}}|{{.Label "io.ascnucc.deployment-id"}}' 2>/dev/null || true)
  [ -z "$DEPLOY_OWNERSHIP_LINES" ] && return 0
  printf '%s\n' "$DEPLOY_OWNERSHIP_LINES" | while IFS='|' read -r DEPLOY_CONTAINER_ID DEPLOY_CONTAINER_OWNER; do
    if [ "$DEPLOY_CONTAINER_OWNER" != "$ASCNUCC_DEPLOYMENT_ID" ]; then
      printf '%s\n' "$DEPLOY_CONTAINER_ID"
    fi
  done | grep -q . && return 1
  return 0
}

resource_owned_or_absent() {
  DEPLOY_RESOURCE_KIND=$1
  DEPLOY_RESOURCE_NAME=$2
  if ! DEPLOY_RESOURCE_OWNER=$(docker "$DEPLOY_RESOURCE_KIND" inspect --format '{{with .Labels}}{{index . "io.ascnucc.deployment-id"}}{{end}}' "$DEPLOY_RESOURCE_NAME" 2>/dev/null); then
    return 0
  fi
  [ "$DEPLOY_RESOURCE_OWNER" = "$ASCNUCC_DEPLOYMENT_ID" ]
}

check_deployment_ownership() {
  check_container_ownership || return 1
  if has_role web || has_role cms; then
    resource_owned_or_absent network "${ASCNUCC_COMPOSE_PROJECT}_app" || return 1
  fi
  if has_role cms || has_role data; then
    resource_owned_or_absent network "${ASCNUCC_COMPOSE_PROJECT}_data" || return 1
  fi
  if has_role data && [ "${ASCNUCC_DATA_STORAGE:-}" = docker ]; then
    resource_owned_or_absent volume "${ASCNUCC_COMPOSE_PROJECT}_postgres_data" || return 1
    resource_owned_or_absent volume "${ASCNUCC_COMPOSE_PROJECT}_minio_data" || return 1
  fi
}

probe_command() {
  load_configuration
  DEPLOY_PROBE_ERRORS=0
  DEPLOY_PROBE_WARNINGS=0
  DEPLOY_PROBE_ERROR_TEXT=
  DEPLOY_PROBE_WARNING_TEXT=

  [ "${ASCNUCC_CONFIG_SCHEMA:-}" = "$DEPLOY_SCHEMA" ] || add_probe_error "Unsupported configuration schema: ${ASCNUCC_CONFIG_SCHEMA:-missing}."
  [ -n "${ASCNUCC_DEPLOYMENT_ID:-}" ] || add_probe_error 'Deployment ID is missing.'
  [ -n "${ASCNUCC_COMPOSE_PROJECT:-}" ] || add_probe_error 'Compose project is missing.'
  printf '%s' "${ASCNUCC_DEPLOYMENT_ID:-}" | grep -Eq '^ascnucc-[0-9a-f]{12}$' || add_probe_error 'Deployment ID has an invalid format.'
  printf '%s' "${ASCNUCC_COMPOSE_PROJECT:-}" | grep -Eq '^ascnucc_[0-9a-f]{12}$' || add_probe_error 'Compose project has an invalid format.'
  valid_environment "${ASCNUCC_ENVIRONMENT:-}" || add_probe_error 'Environment must be production or demo.'
  valid_release "${ASCNUCC_RELEASE:-}" || add_probe_error 'Release must be latest or an exact semantic version.'
  ASCNUCC_ROLES=$(normalize_roles "${ASCNUCC_ROLES:-}")
  export ASCNUCC_ROLES

  [ -f "$DEPLOY_COMPOSE_FILE" ] || add_probe_error 'compose.deploy.yaml is missing from the deployment bundle.'
  if command -v stat >/dev/null 2>&1; then
    DEPLOY_CONFIG_MODE=$(stat -c '%a' "$DEPLOY_CONFIG_FILE" 2>/dev/null || true)
    [ "$DEPLOY_CONFIG_MODE" = 600 ] || add_probe_error "Deployment configuration must have mode 600 (found ${DEPLOY_CONFIG_MODE:-unknown})."
    DEPLOY_CONFIG_DIR_MODE=$(stat -c '%a' "$DEPLOY_CONFIG_DIR" 2>/dev/null || true)
    [ "$DEPLOY_CONFIG_DIR_MODE" = 700 ] || add_probe_error "Deployment configuration directory must have mode 700 (found ${DEPLOY_CONFIG_DIR_MODE:-unknown})."
    if [ "${ASCNUCC_REGISTRY_AUTH_MODE:-}" = dedicated ] && [ -f "$DEPLOY_DOCKER_CONFIG_DIR/config.json" ]; then
      DEPLOY_DOCKER_CONFIG_MODE=$(stat -c '%a' "$DEPLOY_DOCKER_CONFIG_DIR/config.json" 2>/dev/null || true)
      [ "$DEPLOY_DOCKER_CONFIG_MODE" = 600 ] || add_probe_error "Dedicated Docker config must have mode 600 (found ${DEPLOY_DOCKER_CONFIG_MODE:-unknown})."
    fi
  else
    add_probe_warning 'File modes could not be checked because stat is unavailable.'
  fi

  command -v docker >/dev/null 2>&1 || add_probe_error 'Docker CLI is unavailable.'
  if command -v docker >/dev/null 2>&1; then
    docker info >/dev/null 2>&1 || add_probe_error 'Docker daemon is unavailable to the current user.'
    compose_version_ok || add_probe_error "Docker Compose $DEPLOY_MIN_COMPOSE_MAJOR.$DEPLOY_MIN_COMPOSE_MINOR or newer is required."
  fi

  DEPLOY_ARCH=$(uname -m 2>/dev/null || true)
  case "$DEPLOY_ARCH" in
    x86_64|amd64|aarch64|arm64) ;;
    *) add_probe_error "Unsupported CPU architecture: ${DEPLOY_ARCH:-unknown}; supported: amd64, arm64." ;;
  esac

  if ! ip_is_local "${ASCNUCC_APP_BIND_IP:-127.0.0.1}"; then add_probe_error "Application bind IP is not assigned to this host: ${ASCNUCC_APP_BIND_IP:-missing}."; fi
  if has_role data && ! ip_is_local "${ASCNUCC_DATA_BIND_IP:-127.0.0.1}"; then add_probe_error "Data bind IP is not assigned to this host: ${ASCNUCC_DATA_BIND_IP:-missing}."; fi

  has_role web && check_port "$ASCNUCC_WEB_PORT" Web
  has_role cms && check_port "$ASCNUCC_CMS_PORT" CMS
  if has_role data; then
    check_port "$ASCNUCC_POSTGRES_PORT" PostgreSQL
    check_port "$ASCNUCC_MINIO_PORT" 'MinIO API'
    check_port "$ASCNUCC_MINIO_CONSOLE_PORT" 'MinIO console'
    if [ "${ASCNUCC_DATA_STORAGE:-}" = bind ]; then
      validate_custom_data_root "$ASCNUCC_DATA_ROOT"
      for DEPLOY_DATA_PATH in "$ASCNUCC_POSTGRES_DATA_SOURCE" "$ASCNUCC_MINIO_DATA_SOURCE"; do
        [ -d "$DEPLOY_DATA_PATH" ] || add_probe_error "Data directory does not exist: $DEPLOY_DATA_PATH."
        [ -w "$DEPLOY_DATA_PATH" ] || add_probe_error "Data directory is not writable: $DEPLOY_DATA_PATH."
      done
      [ ! -d "$ASCNUCC_DATA_ROOT" ] || check_free_space "$ASCNUCC_DATA_ROOT" 'custom data filesystem'
    elif [ "${ASCNUCC_DATA_STORAGE:-}" = docker ]; then
      DEPLOY_DOCKER_ROOT=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)
      if [ -n "$DEPLOY_DOCKER_ROOT" ] && [ -e "$DEPLOY_DOCKER_ROOT" ]; then
        check_free_space "$DEPLOY_DOCKER_ROOT" 'Docker data filesystem'
      else
        add_probe_warning 'Docker data filesystem free space could not be checked from this account.'
      fi
    else
      add_probe_error 'Data storage must be docker or bind.'
    fi
  fi

  if has_role cms; then
    [ -n "${DATABASE_URL:-}" ] || add_probe_error 'DATABASE_URL is required for the CMS role.'
    [ -n "${PAYLOAD_SECRET:-}" ] || add_probe_error 'PAYLOAD_SECRET is required for the CMS role.'
    [ -n "${MEDIA_S3_ENDPOINT:-}" ] || add_probe_error 'S3 endpoint is required for the CMS role.'
    [ -n "${MEDIA_S3_REGION:-}" ] || add_probe_error 'S3 region is required for the CMS role.'
    [ -n "${MEDIA_S3_BUCKET:-}" ] || add_probe_error 'S3 bucket is required for the CMS role.'
    [ -n "${MEDIA_S3_ACCESS_KEY_ID:-}" ] || add_probe_error 'S3 access key is required for the CMS role.'
    [ -n "${MEDIA_S3_SECRET_ACCESS_KEY:-}" ] || add_probe_error 'S3 secret key is required for the CMS role.'
    if ! has_role data; then
      [ -z "${DATABASE_URL:-}" ] || check_external_url "$DATABASE_URL" 5432 'External PostgreSQL'
      [ -z "${MEDIA_S3_ENDPOINT:-}" ] || {
        case "$MEDIA_S3_ENDPOINT" in https://*) DEPLOY_S3_DEFAULT_PORT=443 ;; *) DEPLOY_S3_DEFAULT_PORT=80 ;; esac
        check_external_url "$MEDIA_S3_ENDPOINT" "$DEPLOY_S3_DEFAULT_PORT" 'External S3'
      }
    fi
  fi
  if has_role web; then
    [ -n "${CMS_API_URL:-}" ] || add_probe_error 'CMS_API_URL is required for the Web role.'
    if ! has_role cms && [ -n "${CMS_API_URL:-}" ]; then
      case "$CMS_API_URL" in https://*) DEPLOY_CMS_DEFAULT_PORT=443 ;; *) DEPLOY_CMS_DEFAULT_PORT=80 ;; esac
      check_external_url "$CMS_API_URL" "$DEPLOY_CMS_DEFAULT_PORT" 'External CMS API'
    fi
  fi

  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    check_deployment_ownership || add_probe_error 'The Compose project resources include containers, networks, or volumes that do not belong to this deployment.'
    if has_role web && ! registry_access_ok web; then add_probe_error 'Web image or private GHCR authentication is unavailable.'; fi
    if has_role cms && ! registry_access_ok cms; then add_probe_error 'CMS image or private GHCR authentication is unavailable.'; fi
    if has_role data; then
      docker_cli manifest inspect "$ASCNUCC_POSTGRES_IMAGE" >/dev/null 2>&1 || add_probe_error 'The pinned PostgreSQL image is unavailable through the configured registry/proxy.'
      docker_cli manifest inspect "$ASCNUCC_MINIO_IMAGE" >/dev/null 2>&1 || add_probe_error 'The pinned MinIO image is unavailable through the configured registry/proxy.'
      docker_cli manifest inspect "$ASCNUCC_MC_IMAGE" >/dev/null 2>&1 || add_probe_error 'The pinned MinIO client image is unavailable through the configured registry/proxy.'
    fi
    if [ -f "$DEPLOY_COMPOSE_FILE" ]; then
      if [ -z "${ASCNUCC_WEB_IMAGE:-}" ] && has_role web; then ASCNUCC_WEB_IMAGE=$(image_reference web "$ASCNUCC_RELEASE"); export ASCNUCC_WEB_IMAGE; fi
      if [ -z "${ASCNUCC_CMS_IMAGE:-}" ] && has_role cms; then ASCNUCC_CMS_IMAGE=$(image_reference cms "$ASCNUCC_RELEASE"); export ASCNUCC_CMS_IMAGE; fi
      compose_cmd config -q >/dev/null 2>&1 || add_probe_error 'Deployment Compose configuration is invalid for the selected roles.'
    fi
  fi

  if [ "$DEPLOY_PROBE_ERRORS" -gt 0 ]; then
    printf 'Probe blocked by %s item(s):%b\n' "$DEPLOY_PROBE_ERRORS" "$DEPLOY_PROBE_ERROR_TEXT" >&2
    [ "$DEPLOY_PROBE_WARNINGS" -eq 0 ] || printf 'Warnings:%b\n' "$DEPLOY_PROBE_WARNING_TEXT" >&2
    printf 'NEXT: Fix the listed items, then run ./deploy probe\n' >&2
    return 1
  fi
  say "Probe passed for roles: $ASCNUCC_ROLES"
  [ "$DEPLOY_PROBE_WARNINGS" -eq 0 ] || printf 'Warnings:%b\n' "$DEPLOY_PROBE_WARNING_TEXT" >&2
}

acquire_lock() {
  mkdir -p "$DEPLOY_CONFIG_DIR"
  if ! mkdir "$DEPLOY_LOCK_DIR" 2>/dev/null; then
    fail "Another deployment update is running or a stale lock exists." "After confirming no deployment process is active, run: rmdir '$DEPLOY_LOCK_DIR'"
  fi
  trap 'rmdir "$DEPLOY_LOCK_DIR" 2>/dev/null || true' EXIT HUP INT TERM
}

release_lock() {
  rmdir "$DEPLOY_LOCK_DIR" 2>/dev/null || true
  trap - EXIT HUP INT TERM
}

inspect_image() {
  DEPLOY_INSPECT_REF=$1
  docker_cli image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}|{{index .Config.Labels "org.opencontainers.image.revision"}}|{{index .Config.Labels "io.ascnucc.component"}}|{{index .RepoDigests 0}}|{{.Architecture}}' "$DEPLOY_INSPECT_REF" 2>/dev/null
}

run_redacted() {
  DEPLOY_REDACT_LOG="$DEPLOY_CONFIG_DIR/command-output.$$"
  if "$@" > "$DEPLOY_REDACT_LOG" 2>&1; then
    DEPLOY_REDACT_STATUS=0
  else
    DEPLOY_REDACT_STATUS=$?
  fi
  if [ "$DEPLOY_REDACT_STATUS" -eq 0 ]; then redact_stream < "$DEPLOY_REDACT_LOG"; else redact_stream < "$DEPLOY_REDACT_LOG" >&2; fi
  rm -f "$DEPLOY_REDACT_LOG"
  return "$DEPLOY_REDACT_STATUS"
}

prepare_images() {
  DEPLOY_PREPARE_RELEASE=$1
  DEPLOY_CANDIDATE_WEB_IMAGE=
  DEPLOY_CANDIDATE_CMS_IMAGE=
  DEPLOY_CANDIDATE_VERSION=
  DEPLOY_CANDIDATE_REVISION=
  for DEPLOY_PREPARE_COMPONENT in web cms; do
    if ! has_role "$DEPLOY_PREPARE_COMPONENT"; then continue; fi
    DEPLOY_PREPARE_REF=$(image_reference "$DEPLOY_PREPARE_COMPONENT" "$DEPLOY_PREPARE_RELEASE")
    step "Pull $DEPLOY_PREPARE_COMPONENT image"
    run_redacted docker_cli pull "$DEPLOY_PREPARE_REF" || fail "Failed to pull the $DEPLOY_PREPARE_COMPONENT image." "Run ./deploy init to refresh GHCR authentication, then retry."
    DEPLOY_PREPARE_META=$(inspect_image "$DEPLOY_PREPARE_REF") || fail "Cannot inspect the pulled $DEPLOY_PREPARE_COMPONENT image." "Run ./deploy probe"
    DEPLOY_PREPARE_VERSION=$(printf '%s' "$DEPLOY_PREPARE_META" | cut -d '|' -f 1)
    DEPLOY_PREPARE_REVISION=$(printf '%s' "$DEPLOY_PREPARE_META" | cut -d '|' -f 2)
    DEPLOY_PREPARE_LABEL=$(printf '%s' "$DEPLOY_PREPARE_META" | cut -d '|' -f 3)
    DEPLOY_PREPARE_DIGEST=$(printf '%s' "$DEPLOY_PREPARE_META" | cut -d '|' -f 4)
    DEPLOY_PREPARE_ARCH=$(printf '%s' "$DEPLOY_PREPARE_META" | cut -d '|' -f 5)
    [ "$DEPLOY_PREPARE_LABEL" = "$DEPLOY_PREPARE_COMPONENT" ] || fail "The pulled image has the wrong ASCNUCC component label." "Select an official ASCNUCC Release."
    [ -n "$DEPLOY_PREPARE_VERSION" ] && [ -n "$DEPLOY_PREPARE_REVISION" ] && [ -n "$DEPLOY_PREPARE_DIGEST" ] || fail "The pulled image is missing release metadata or digest." "Select an official ASCNUCC Release."
    if [ "$DEPLOY_PREPARE_RELEASE" != latest ] && [ "$DEPLOY_PREPARE_VERSION" != "$DEPLOY_PREPARE_RELEASE" ]; then
      fail "The pulled image metadata does not match the requested Release." "Wait for the Release workflow to finish, then retry the exact version."
    fi
    case "$(uname -m):$DEPLOY_PREPARE_ARCH" in
      x86_64:amd64|amd64:amd64|aarch64:arm64|arm64:arm64) ;;
      *) fail "The pulled image architecture does not match this host." "Use an official ASCNUCC image for amd64 or arm64." ;;
    esac
    if [ -n "$DEPLOY_CANDIDATE_VERSION" ]; then
      [ "$DEPLOY_CANDIDATE_VERSION" = "$DEPLOY_PREPARE_VERSION" ] && [ "$DEPLOY_CANDIDATE_REVISION" = "$DEPLOY_PREPARE_REVISION" ] || fail "Web and CMS images are from different releases." "Wait for the Release workflow to finish, then run ./deploy update again."
    else
      DEPLOY_CANDIDATE_VERSION=$DEPLOY_PREPARE_VERSION
      DEPLOY_CANDIDATE_REVISION=$DEPLOY_PREPARE_REVISION
    fi
    if [ "$DEPLOY_PREPARE_COMPONENT" = web ]; then
      DEPLOY_CANDIDATE_WEB_IMAGE=$DEPLOY_PREPARE_DIGEST
    else
      DEPLOY_CANDIDATE_CMS_IMAGE=$DEPLOY_PREPARE_DIGEST
    fi
  done
  export DEPLOY_CANDIDATE_WEB_IMAGE DEPLOY_CANDIDATE_CMS_IMAGE DEPLOY_CANDIDATE_VERSION DEPLOY_CANDIDATE_REVISION
}

use_candidate_images() {
  if has_role web; then ASCNUCC_WEB_IMAGE=$DEPLOY_CANDIDATE_WEB_IMAGE; export ASCNUCC_WEB_IMAGE; fi
  if has_role cms; then ASCNUCC_CMS_IMAGE=$DEPLOY_CANDIDATE_CMS_IMAGE; export ASCNUCC_CMS_IMAGE; fi
}

write_active_state() {
  DEPLOY_STATE_RELEASE=$1
  DEPLOY_STATE_TMP="$DEPLOY_CONFIG_DIR/state.env.new.$$"
  : > "$DEPLOY_STATE_TMP"
  config_write_line "$DEPLOY_STATE_TMP" ASCNUCC_ACTIVE_RELEASE_REQUEST "$DEPLOY_STATE_RELEASE"
  config_write_line "$DEPLOY_STATE_TMP" ASCNUCC_ACTIVE_VERSION "$DEPLOY_CANDIDATE_VERSION"
  config_write_line "$DEPLOY_STATE_TMP" ASCNUCC_ACTIVE_REVISION "$DEPLOY_CANDIDATE_REVISION"
  config_write_line "$DEPLOY_STATE_TMP" ASCNUCC_MIGRATED_REVISION "$DEPLOY_CANDIDATE_REVISION"
  config_write_line "$DEPLOY_STATE_TMP" ASCNUCC_WEB_IMAGE "$DEPLOY_CANDIDATE_WEB_IMAGE"
  config_write_line "$DEPLOY_STATE_TMP" ASCNUCC_CMS_IMAGE "$DEPLOY_CANDIDATE_CMS_IMAGE"
  chmod 600 "$DEPLOY_STATE_TMP"
  mv "$DEPLOY_STATE_TMP" "$DEPLOY_STATE_FILE"
}

confirm_production_migration() {
  [ "$ASCNUCC_ENVIRONMENT" != production ] || {
    require_interactive
    say 'Production migration gate:'
    say '  - Confirm the database is empty, or PostgreSQL and object storage have a coordinated backup.'
    say '  - Database migrations are forward-only; an arbitrary application rollback is not promised.'
    printf 'Type deployment ID %s to continue: ' "$ASCNUCC_DEPLOYMENT_ID" >&2
    IFS= read -r DEPLOY_CONFIRMATION
    [ "$DEPLOY_CONFIRMATION" = "$ASCNUCC_DEPLOYMENT_ID" ] || fail "Production migration was not confirmed." "Verify the backup, then run the command again."
  }
}

start_data_services() {
  if ! has_role data; then return 0; fi
  step 'Start PostgreSQL and MinIO'
  compose_cmd up -d --no-build --wait postgres minio
  step 'Ensure the private media bucket and least-privilege application user'
  compose_cmd run --rm --no-deps minio-init >/dev/null
}

run_migration() {
  if ! has_role cms; then return 0; fi
  step 'Run the release migration'
  run_redacted compose_cmd run --rm --no-deps migrate || fail "Migration failed; the application release was not replaced." "Inspect ./deploy logs cms, then apply a forward fix or coordinate a database/object-storage restore."
}

start_applications() {
  if has_role cms; then
    step 'Start CMS'
    compose_cmd up -d --no-build --wait cms
  fi
  if has_role web; then
    step 'Start Web'
    compose_cmd up -d --no-build --wait web
  fi
}

production_handoff() {
  [ "$ASCNUCC_ENVIRONMENT" != production ] || {
    warn 'Services are running, but production readiness is not complete.'
    say 'Before real use: establish controlled Owner bootstrap and recovery, TLS/entry routing, coordinated PostgreSQL/S3 backup and restore rehearsal, secret rotation, real-device acceptance, and privacy/data-location approval.'
  }
}

up_command() {
  load_configuration
  probe_command
  acquire_lock
  if has_role web || has_role cms; then
    if [ -z "${ASCNUCC_ACTIVE_REVISION:-}" ]; then
      prepare_images "$ASCNUCC_RELEASE"
      use_candidate_images
      confirm_production_migration
      start_data_services
      run_migration
      start_applications
      write_active_state "$ASCNUCC_RELEASE"
    else
      step "Use recorded release ${ASCNUCC_ACTIVE_VERSION:-unknown}"
      start_data_services
      start_applications
    fi
  else
    start_data_services
  fi
  release_lock
  say 'ASCNUCC is running. Next: ./deploy status'
  production_handoff
}

update_command() {
  load_configuration
  has_role web || has_role cms || fail "The data-only role has no ASCNUCC application image to update." "Use ./deploy status"
  DEPLOY_UPDATE_RELEASE=${1:-latest}
  valid_release "$DEPLOY_UPDATE_RELEASE" || fail "Release must be latest or an exact semantic version." "Use ./deploy update or ./deploy update v1.0.0"
  probe_command
  acquire_lock
  prepare_images "$DEPLOY_UPDATE_RELEASE"
  if [ "${ASCNUCC_ACTIVE_REVISION:-}" = "$DEPLOY_CANDIDATE_REVISION" ] && \
    { ! has_role web || [ "${ASCNUCC_WEB_IMAGE:-}" = "$DEPLOY_CANDIDATE_WEB_IMAGE" ]; } && \
    { ! has_role cms || [ "${ASCNUCC_CMS_IMAGE:-}" = "$DEPLOY_CANDIDATE_CMS_IMAGE" ]; }; then
    release_lock
    say "Already running the selected release: $DEPLOY_CANDIDATE_VERSION"
    return 0
  fi
  use_candidate_images
  step 'Update plan'
  say "Current: ${ASCNUCC_ACTIVE_VERSION:-not deployed}"
  say "Target: $DEPLOY_CANDIDATE_VERSION"
  say 'Order: data health -> migration -> CMS -> Web'
  confirm_production_migration
  start_data_services
  run_migration
  start_applications
  write_active_state "$DEPLOY_UPDATE_RELEASE"
  release_lock
  say "Update complete: $DEPLOY_CANDIDATE_VERSION"
  production_handoff
}

assert_managed_containers() {
  check_deployment_ownership || fail "The Compose project includes containers, networks, or volumes not owned by this deployment." "Run ./deploy doctor and resolve the project-name collision."
}

start_command() {
  load_configuration
  assert_managed_containers
  set_compose_scope
  step 'Start existing ASCNUCC containers'
  # DEPLOY_SELECTED_SERVICES contains only fixed service names.
  # shellcheck disable=SC2086
  compose_cmd start $DEPLOY_SELECTED_SERVICES || fail "One or more containers do not exist yet." "Run ./deploy up"
  say 'ASCNUCC containers started.'
}

stop_command() {
  load_configuration
  assert_managed_containers
  set_compose_scope
  step 'Stop ASCNUCC containers without deleting data'
  # shellcheck disable=SC2086
  compose_cmd stop $DEPLOY_SELECTED_SERVICES
  say 'ASCNUCC containers stopped. Docker volumes and files were kept.'
}

restart_command() {
  load_configuration
  assert_managed_containers
  set_compose_scope
  step 'Restart existing ASCNUCC containers'
  # shellcheck disable=SC2086
  compose_cmd restart $DEPLOY_SELECTED_SERVICES
  say 'ASCNUCC containers restarted.'
}

status_command() {
  load_configuration
  assert_managed_containers
  set_compose_scope
  say "Deployment: $ASCNUCC_DEPLOYMENT_ID"
  say "Configured roles: $ASCNUCC_ROLES"
  say "Active release: ${ASCNUCC_ACTIVE_VERSION:-not deployed}"
  # shellcheck disable=SC2086
  compose_cmd ps $DEPLOY_SELECTED_SERVICES
}

logs_command() {
  load_configuration
  assert_managed_containers
  DEPLOY_LOG_SERVICE=${1:-}
  if [ -n "$DEPLOY_LOG_SERVICE" ]; then
    case "$DEPLOY_LOG_SERVICE" in
      web) has_role web || fail "Web is not part of this deployment." "Run ./deploy status" ;;
      cms) has_role cms || fail "CMS is not part of this deployment." "Run ./deploy status" ;;
      postgres|minio) has_role data || fail "$DEPLOY_LOG_SERVICE is not part of this deployment." "Run ./deploy status" ;;
      *) fail "Unknown log service: $DEPLOY_LOG_SERVICE" "Use web, cms, postgres, or minio."
    esac
    run_redacted compose_cmd logs --tail 200 "$DEPLOY_LOG_SERVICE"
  else
    set_compose_scope
    # shellcheck disable=SC2086
    run_redacted compose_cmd logs --tail 200 $DEPLOY_SELECTED_SERVICES
  fi
}

doctor_command() {
  load_configuration
  step 'Fast deployment probe'
  probe_command
  step 'Container ownership and health'
  assert_managed_containers
  status_command
  if has_role cms && [ -n "${ASCNUCC_CMS_IMAGE:-}" ]; then
    step 'Migration status'
    run_redacted compose_cmd run --rm --no-deps migrate pnpm --dir apps/cms migrate:status
  fi
  if [ -d "$DEPLOY_LOCK_DIR" ]; then
    warn "An update lock exists at $DEPLOY_LOCK_DIR."
  fi
  production_handoff
  say 'Doctor checks completed.'
}

seed_command() {
  load_configuration
  [ "${1:-}" = --demo ] || fail "Seed requires the explicit --demo flag." "Use ./deploy seed --demo only for a disposable fictional Demo deployment."
  [ "$ASCNUCC_ENVIRONMENT" = demo ] || fail "Demo seed is forbidden outside the demo environment." "Create a separate demo deployment with ./deploy init."
  has_role cms && has_role data || fail "Demo seed requires CMS and the deployment-managed PostgreSQL service." "Use an all or cms,data demo deployment."
  [ "$POSTGRES_DB" = ascnucc_demo_dev ] || fail "Demo seed requires the fixed ascnucc_demo_dev database." "Do not seed this database."
  case "$DATABASE_URL" in
    postgres://*@postgres:5432/ascnucc_demo_dev) ;;
    *) fail "Demo seed is not connected to the managed demo database." "Do not seed this database." ;;
  esac
  [ -n "${ASCNUCC_CMS_IMAGE:-}" ] || fail "No deployed CMS release is recorded." "Run ./deploy up"
  acquire_lock
  step 'Seed fictional Demo data'
  ASCNUCC_DEPLOYMENT_DEMO_SEED=true
  export ASCNUCC_DEPLOYMENT_DEMO_SEED
  run_redacted compose_cmd run --rm --no-deps \
    -e ASCNUCC_DEPLOYMENT_DEMO_SEED \
    -e ASCNUCC_ENVIRONMENT \
    -e DEMO_ADMIN_USERNAME -e DEMO_ADMIN_PASSWORD \
    -e DEMO_STAFF_USERNAME -e DEMO_STAFF_PASSWORD \
    -e DEMO_CADRE_USERNAME -e DEMO_CADRE_PASSWORD \
    migrate pnpm --dir apps/cms seed || fail "Demo seed failed." "Run ./deploy doctor"
  release_lock
  say 'Fictional Demo data is ready. Credentials remain only in the protected local configuration.'
}

help_command() {
  cat <<'EOF'
ASCNUCC portable deployment tool

Usage:
  ./deploy init                 Guided first-time setup or GHCR login refresh
  ./deploy probe                Fast, read-only role-aware environment checks
  ./deploy up                   Pull/prepare the configured release and start it
  ./deploy update [release]     Update to latest, or to an exact vX.Y.Z release
  ./deploy start                Start existing containers
  ./deploy stop                 Stop containers without deleting data
  ./deploy restart              Restart existing containers
  ./deploy status               Show the active release and container state
  ./deploy logs [service]       Show the last 200 redacted log lines
  ./deploy doctor               Run deeper health and migration checks
  ./deploy seed --demo          Explicitly load fictional Demo data
  ./deploy help                 Show this guide

Roles:
  all       Web + CMS + PostgreSQL + MinIO
  web       Public Web/BFF only; requires an external CMS URL
  cms       CMS/API/Runner only; requires external PostgreSQL and private S3
  data      PostgreSQL + MinIO only
  cms,data  CMS with deployment-managed data on the same host

Defaults are conservative: loopback listeners, Docker-managed volumes, private
GHCR images pinned to resolved digests, no automatic Demo seed, and no volume
deletion.
init, up, and update run the fast probe automatically; doctor is only for deeper
troubleshooting, so normal operation does not require a checklist of commands.
The tool never changes the host firewall, TLS, reverse proxy, Docker daemon,
DNS, system proxy, Tailscale, or unrelated services.
EOF
}

DEPLOY_COMMAND=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$DEPLOY_COMMAND" in
  init) [ "$#" -eq 0 ] || fail "init takes no arguments." "Run ./deploy help"; init_command ;;
  probe) [ "$#" -eq 0 ] || fail "probe takes no arguments." "Run ./deploy help"; probe_command ;;
  up) [ "$#" -eq 0 ] || fail "up takes no arguments." "Run ./deploy help"; up_command ;;
  update) [ "$#" -le 1 ] || fail "update accepts at most one Release." "Run ./deploy update or ./deploy update v1.0.0"; update_command "${1:-latest}" ;;
  start) [ "$#" -eq 0 ] || fail "start takes no arguments." "Run ./deploy help"; start_command ;;
  stop) [ "$#" -eq 0 ] || fail "stop takes no arguments." "Run ./deploy help"; stop_command ;;
  restart) [ "$#" -eq 0 ] || fail "restart takes no arguments." "Run ./deploy help"; restart_command ;;
  status) [ "$#" -eq 0 ] || fail "status takes no arguments." "Run ./deploy help"; status_command ;;
  logs) [ "$#" -le 1 ] || fail "logs accepts at most one service." "Run ./deploy logs cms"; logs_command "${1:-}" ;;
  doctor) [ "$#" -eq 0 ] || fail "doctor takes no arguments." "Run ./deploy help"; doctor_command ;;
  seed) [ "$#" -le 1 ] || fail "seed accepts only --demo." "Run ./deploy seed --demo"; seed_command "${1:-}" ;;
  help|-h|--help) help_command ;;
  *) fail "Unknown command: $DEPLOY_COMMAND" "Run ./deploy help" ;;
esac
